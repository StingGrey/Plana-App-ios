<?xml version="1.0" encoding="utf-8"?>
<!--
  明文流量收窄。

  原先在 manifest 上开 android:usesCleartextTraffic="true" 是为了让用户能填
  自建局域网后端(http://192.168.x.x:8000),用途合理 —— 但那是**全局**开关,
  等于所有请求都允许明文,包括发往 novelai.net 的令牌。

  这里改成:默认强制 TLS,只对私有网段与本机放行明文。自建局域网后端照用不误,
  公网地址一律走 https。见 docs/audit-findings.md S1A-08。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- RFC1918 私有网段 + 本机回环 + .local:自建后端的实际落点 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
