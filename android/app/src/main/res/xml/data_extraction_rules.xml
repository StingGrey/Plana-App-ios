<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份/迁移规则。与 allowBackup="false" 同一目的:
  凭据(secure storage)的密文备份出去也解不开(Keystore 密钥不参与备份),
  恢复后只会触发插件的 resetOnError 把它清掉 —— 不如一开始就不备份。

  cloud-backup 与 device-transfer 都整体排除。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
